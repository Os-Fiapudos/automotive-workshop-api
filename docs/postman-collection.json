    {
      "name": "Service orders",
      "item": [
        {
          "name": "Open service order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-orders"
              ]
            },
            "description": "Requires a valid JWT (this route was wrapped in requireAuth on 2026-08-26, closing VULN-02 — see CLAUDE.md section 1). The customer may be identified by customerId or customerDocument, and the vehicle by vehicleId or licensePlate. The response carries trackingToken and code, both stored by the test script for the customer-facing routes below.",
