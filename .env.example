POSTGRES_USER=workshop
POSTGRES_PASSWORD=workshop
POSTGRES_DB=automotive_workshop
POSTGRES_PORT=5432

ADMINER_PORT=8081
API_PORT=8080
SWAGGER_UI_PORT=8082

# JWT signing secret - REQUIRED, at least 32 bytes long (the app fails fast
# otherwise). Generate a strong random value per environment
# (e.g. `openssl rand -hex 32`). Never commit the real value.
JWT_SECRET=change-me-dev-only-please-generate-a-real-random-value
JWT_TTL=1h

# Shared secret an external system presents in the X-External-Notification-Secret
# header to relay a customer's quote decision
# (POST /api/v1/service-orders/{id}/quote/decision). REQUIRED - the app fails fast
# without it. Generate a strong random value per environment
# (e.g. `openssl rand -hex 32`). Never commit the real value.
EXTERNAL_NOTIFICATION_SECRET=change-me-dev-only-external-notification-secret

# Shared secret the external status-update tool (the n8n workflow in
# tools/n8n/) presents in the X-External-Status-Secret header
# (POST /api/v1/service-orders/{id}/status). REQUIRED, and must be DIFFERENT
# from EXTERNAL_NOTIFICATION_SECRET - the app fails fast otherwise. Generate a
# strong random value per environment (e.g. `openssl rand -hex 32`).
EXTERNAL_STATUS_UPDATE_SECRET=change-me-dev-only-external-status-update-secret

# n8n (external status-update tool) - http://localhost:5678
N8N_PORT=5678

# Quote-sent e-mail notification (Resend) - OPTIONAL, set both or neither.
# Without RESEND_API_KEY the notification is disabled (no-op). A key without
# RESEND_FROM_EMAIL makes the app fail at startup. Never commit a real key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Administrative user bootstrap (cmd/bootstrap-admin, `make bootstrap-admin`) -
# OPTIONAL locally, where docs/seed.sql already creates users. In a deployed
# environment these come from a Secret, never from Git. The password must be
# 12 to 72 bytes long; an existing user with the same e-mail is left unchanged.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
